generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomType {
  SINGLE
  DOUBLE
  SUITE

  @@map("room_type")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED

  @@map("booking_status")
}

// Entidad de la tabla public.user (misma forma que el UserRecord de dominio).
model User {
  id       Int     @id @default(autoincrement())
  name     String?
  login    String?
  password String?

  bookings Booking[]

  @@map("user")
}

model Room {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  type          RoomType
  capacity      Int
  pricePerNight Decimal  @map("price_per_night") @db.Decimal(10, 2)
  description   String?  @db.VarChar(255)

  bookings Booking[]

  @@map("room")
}

model Booking {
  id         Int           @id @default(autoincrement())
  userId     Int           @map("user_id")
  roomId     Int           @map("room_id")
  startDate  DateTime      @map("start_date")
  endDate    DateTime      @map("end_date")
  status     BookingStatus @default(PENDING)
  totalPrice Decimal       @map("total_price") @db.Decimal(10, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId], name: "booking_user_id_foreign")
  @@index([roomId], name: "booking_room_id_foreign")
  @@map("booking")
}
